{
  "manifest_version": 3,
  "name": "loopy 담기",
  "version": "0.3.1",
  "description": "YouTube 영상과 재생목록을 loopy에 전달합니다.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["https://loopy.bearsharks.dev/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "loopy 담은 목록" },
  "web_accessible_resources": [{ "resources": ["popup.html"], "matches": ["https://www.youtube.com/*"] }],
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }, { "matches": ["https://loopy.bearsharks.dev/*"], "js": ["app-bridge.js"], "run_at": "document_start" }],
  "externally_connectable": { "matches": ["https://loopy.bearsharks.dev/*"] },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.github.com; img-src https://i.ytimg.com" }
}
