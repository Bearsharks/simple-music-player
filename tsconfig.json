{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "resolveJsonModule": true,
    "isolatedModules": true, "noEmit": true,
    "paths": {"app/*": ["./src/app/*"], "features/*": ["./src/features/*"], "shared/*": ["./src/shared/*"], "test/*": ["./src/test/*"]},
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "vite.config.ts", ".storybook"]
}
